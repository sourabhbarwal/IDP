# Copy to .env for local development. Real secrets must NEVER be committed.

NODE_ENV=development
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=idp
DB_PASSWORD=***REMOVED***
DB_NAME=idp
DB_SCHEMA=auth

# Redis (reserved for future use - rate limiting, caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (HS256 shared secret for MVP - see ADR-0003; rotate in prod via Vault)
JWT_SECRET=***REMOVED***
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ISSUER=idp-platform
