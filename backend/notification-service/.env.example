NODE_ENV=development
PORT=3009

JWT_SECRET=<generate-a-long-random-string>
JWT_ISSUER=idp-platform

# Must match AlertManager's bearer_token config
WEBHOOK_TOKEN=<generate-a-random-token>

# ── Notification channels (uncomment to activate) ────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
# GENERIC_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# ALERT_EMAIL_TO=team@yourcompany.com