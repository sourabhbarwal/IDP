NODE_ENV=development
PORT=3005

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=idp
DB_PASSWORD=<generate-a-strong-password>
DB_NAME=idp
DB_SCHEMA=deployment

JWT_SECRET=<generate-a-long-random-string>
JWT_ISSUER=idp-platform

# Kubernetes — path to kubeconfig (kind writes here by default)
# Leave unset to use in-cluster config when running inside K8s
KUBECONFIG_PATH=
# Container registry prefix used when building image references
IMAGE_REGISTRY=idp-platform