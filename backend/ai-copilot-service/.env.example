NODE_ENV=development
PORT=3012

JWT_SECRET=change-me
JWT_ISSUER=idp-platform

# Groq API — get free key at console.groq.com
GROQ_API_KEY=***REMOVED***
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024

# Docker Compose DNS (change to localhost:* for local dev outside compose)
ALERT_SERVICE_URL=http://alert-service:3008
COST_SERVICE_URL=http://cost-service:3011
MONITORING_SERVICE_URL=http://monitoring-service:3006
LOGGING_SERVICE_URL=http://logging-service:3007