NODE_ENV=development
PORT=3008

# Shared database — same postgres as all other services
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=idp
DB_PASSWORD=<generate-a-strong-password>
DB_NAME=idp
DB_SCHEMA=alert

JWT_SECRET=<generate-a-long-random-string>
JWT_ISSUER=idp-platform

# Docker Compose DNS (when running via docker-compose)
# Change to localhost:9093 when running locally outside compose
ALERTMANAGER_URL=http://alertmanager:9093

# Must match AlertManager's webhook bearer_token
WEBHOOK_TOKEN=<generate-a-random-token>